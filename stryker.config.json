{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "refactor/evidence/phase-0/reports/mutation/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/llm/reasoning-marker.ts"
  ],
  "ignoreStatic": true,
  "timeoutMS": 60000,
  "concurrency": 2,
  "tempDirName": ".stryker-tmp"
}
