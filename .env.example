GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
AGENTROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Modal Endpoints — needs all three. The endpoint URL is per workspace, and
# MODAL_BASE_URL overrides the endpoint list stored by `clai set modal --url`.
# https://modal.com/docs/guide/endpoints
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Lightning AI Model APIs — key at
# https://lightning.ai/lightning-ai/model-apis/models?showApiKey=true
LIGHTNING_API_KEY=
# Optional: override the shared gateway (e.g. a private Lightning Inference
# deployment). Overrides the endpoint list stored by `clai set lightning --url`.
LIGHTNING_BASE_URL=

# TokenRouter — OpenAI-compatible gateway to Kimi / DeepSeek / Qwen / GLM /
# GPT-OSS / MiniMax. Key from your account's API Keys page.
# https://docs.tokenrouter.me
TOKENROUTER_API_KEY=
# Optional: override the base URL (defaults to https://api.tokenrouter.com/v1).
TOKENROUTER_BASE_URL=

# OrcaRouter — OpenAI-compatible multi-provider gateway (OpenAI, Anthropic,
# Google, DeepSeek, Grok, Qwen, Kimi, MiniMax, GLM). Key from
# https://www.orcarouter.ai/console (starts with sk-).
# https://docs.orcarouter.ai
ORCAROUTER_API_KEY=
